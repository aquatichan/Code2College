# Required. Generate with: python -m hwserver.keygen
# Losing this means every user must sign in to Hirewheel again.
HW_SECRET_KEY=

# Enrollment gate. Leave empty ONLY while you are the sole user.
HW_INVITE_CODE=

# "local" opens a browser window on this machine (dev / single user).
# "novnc" streams a server-side browser to the app (needs the container).
HW_LOGIN_MODE=local

# Public base URL the phone can reach the server at. The novnc sign-in stream
# is served from the same address.
HW_PUBLIC_URL=http://localhost:8000

# "production" refuses to start without a secret key, an invite code, an https
# HW_PUBLIC_URL and novnc login. Leave it as development on your own machine.
# HW_ENV=development

# --- Push -------------------------------------------------------------------
# "none" stores device tokens but sends nothing; the app falls back to background
# refresh + local notifications, which needs no Apple Developer account.
# Switch to "apns" once you have one, and fill in the four values below.
HW_PUSH_BACKEND=none

# HW_APNS_KEY_PATH=/secrets/AuthKey_ABC1234567.p8
#   ...or paste the key itself (hosts that keep secrets as env vars):
# HW_APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# HW_APNS_KEY_ID=ABC1234567
# HW_APNS_TEAM_ID=TEAM123456
# HW_APNS_BUNDLE_ID=com.aaronqin.hirewatch
# Devices report their own gateway (Debug → sandbox, TestFlight → production);
# this is only the fallback for builds that don't.
# HW_APNS_ENVIRONMENT=sandbox

# --- Optional overrides -----------------------------------------------------
# HW_DATA_DIR=./data
# HW_INTERVAL_SECONDS=10800   (every account scans every 3 hours)
# HW_RETENTION_DAYS=3
# HW_HOST=127.0.0.1
# HW_PORT=8000
