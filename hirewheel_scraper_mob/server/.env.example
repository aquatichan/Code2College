# Required. Generate with: python -m hwserver.keygen
# Losing this means every user must sign in to Hirewheel again.
HW_SECRET_KEY=

# Enrollment gate. Leave empty ONLY while you are the sole user.
HW_INVITE_CODE=

# "local" opens a browser window on this machine (dev / single user).
# "novnc" streams a server-side browser to the app (needs the container).
HW_LOGIN_MODE=local

# Public base URL the phone can reach the server at (novnc mode builds the
# stream URL from this, stripping the port and adding each login's own).
HW_PUBLIC_URL=http://localhost:8000

# Override only if the noVNC stream is reached at a different host than the API.
# HW_STREAM_BASE=https://watch.example.com

# --- Push -------------------------------------------------------------------
# "none" stores device tokens but sends nothing; the app falls back to background
# refresh + local notifications, which needs no Apple Developer account.
# Switch to "apns" once you have one, and fill in the four values below.
HW_PUSH_BACKEND=none

# HW_APNS_KEY_PATH=/secrets/AuthKey_ABC1234567.p8
# HW_APNS_KEY_ID=ABC1234567
# HW_APNS_TEAM_ID=TEAM123456
# HW_APNS_BUNDLE_ID=com.aaronqin.HirewheelWatch
# "sandbox" for development builds, "production" for TestFlight / App Store.
# HW_APNS_ENVIRONMENT=sandbox

# --- In-app purchases -------------------------------------------------------
# Faster scan intervals are one-time StoreKit purchases, verified here rather
# than trusted from the device.
#
# Apple's root certificate (PEM or DER), from
# https://www.apple.com/certificateauthority/ — required in production.
# HW_APPSTORE_ROOT_CA=/secrets/AppleRootCA-G3.cer

# Accepts well-formed transactions WITHOUT proving Apple issued them. Only for
# Xcode's local StoreKit testing, which signs with its own throwaway cert.
# Never set this on a server real money touches.
HW_ALLOW_UNVERIFIED_PURCHASES=0

# Which App Store environment this server honours: "sandbox" or "production".
#
# TestFlight purchases are ALWAYS sandbox and ALWAYS free, yet Apple signs them
# with a genuine certificate chain — so the signature check alone cannot tell a
# free tester purchase from a paid one. A production server must be set to
# "production" or it can be unlocked for nothing by replaying a TestFlight
# transaction. Keep it on "sandbox" while testing with friends.
HW_APPSTORE_ENVIRONMENT=sandbox

# --- Optional overrides -----------------------------------------------------
# HW_DATA_DIR=./data
# HW_INTERVAL_SECONDS=10800
# HW_RETENTION_DAYS=3
# HW_HOST=127.0.0.1
# HW_PORT=8000
