<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode signs Debug builds against the APNs sandbox and rewrites this to
	     "production" when an archive is exported for TestFlight / the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
