<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this iOS silently refuses to run the background refresh task. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).refresh</string>
	</array>
	<!-- Server the sign-in screen starts with: localhost for Debug, the hosted
	     server for Release (TestFlight / App Store). Set per configuration via
	     the HW_DEFAULT_SERVER build setting. -->
	<key>HWDefaultServerURL</key>
	<string>$(HW_DEFAULT_SERVER)</string>
	<!-- Only standard HTTPS, which is exempt; saves answering the export
	     compliance question on every TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Allows talking to a server at plain http:// on your LAN during testing. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
