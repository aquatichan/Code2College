<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this iOS silently refuses to run the background refresh task. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.aaronqin.HirewheelWatch.refresh</string>
	</array>
	<!-- Allows talking to a server at plain http:// on your LAN during testing. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
